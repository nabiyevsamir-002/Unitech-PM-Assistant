# UniTech PM AI Assistant — Docker Compose environment (track 5c).
# Copy to `.env.docker` and fill in real secrets, then:
#   docker compose --env-file .env.docker up -d --build
# NEVER commit the filled-in .env.docker (.gitignore already excludes .env*).

# --- Required ---
# Strong random secret for next-auth session signing.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48

# Public origin (scheme + host, no trailing slash). REQUIRED in production behind
# a reverse proxy so next-auth redirects (sign-out, OAuth callbacks) point at your
# real domain instead of the container's internal 0.0.0.0:3000. Leave blank for
# pure-localhost testing.
#   e.g. AUTH_URL=https://unitech-pm-assistant.duckdns.org
AUTH_URL=

# --- Recommended (has a dev default in compose.yaml, override for production) ---
# PostgreSQL password (user `unitech`, db `unitech_pm`).
POSTGRES_PASSWORD=unitech_dev_pw

# --- Optional ---
# Ollama models. Bump to a ~14B chat model on a beefier / GPU host for better AZ output.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Host port the app is published on (loopback-only; see compose.yaml).
APP_PORT=3000

# Telegram notifications (optional, 5d). Leave empty to disable (app no-ops).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# after messaging the bot (or a group/channel id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email/SMTP notifications (optional, 5d). Leave empty to disable (app no-ops).
# Port 465 = implicit TLS; 587 = STARTTLS. NOTIFY_EMAIL_TO defaults to SMTP_FROM/USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# OneDrive / Microsoft Graph Excel sync (optional, 5d). Azure app registration with
# Files.ReadWrite.All (application) + admin consent. Leave empty to disable.
# A project's Excel source uses a fileLocation of the form:
#   msgraph:/drives/{driveId}/items/{itemId}
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=

# Google OAuth sign-in (optional). Set BOTH to show the "Continue with Google"
# button. Google Cloud console → Credentials → OAuth client ID (Web app).
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# Convenience sign-in for EXISTING active accounts only (email match); it does
# not create accounts — that stays in /register with the admin-approval gate.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Production only (compose.prod.yaml / Caddy) ---
# Your domain, DNS A record pointing at the server's public IP. Caddy provisions
# a Let's Encrypt TLS cert for it automatically. Leave as localhost for a local test.
DOMAIN=localhost
